root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 内核代码风格：制表符缩进，行宽 100 列以内（Documentation/process/coding-style.rst）
[*.{c,h}]
indent_style = tab
indent_size = 8
max_line_length = 100

[Makefile]
indent_style = tab

[Kbuild]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
